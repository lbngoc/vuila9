---
layout: base.njk
title: Bảng xếp hạng
permalink: /leaderboard/
---

<script>
  const LEADERBOARD_DATA = {{ leaderboard.data | dump | safe }};
</script>

<div class="space-y-6" x-data="leaderboardPage(LEADERBOARD_DATA)">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 sm:gap-4">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">🏆 Bảng xếp hạng</h1>
    <p class="text-xs text-gray-500 dark:text-gray-600 sm:text-right sm:flex-shrink-0">
      {% if leaderboard.generated_at %}Cập nhật: {{ leaderboard.generated_at | dateDisplay }}{% endif %}
      {% if sheetConfig.picks_tab_url and siteConfig.public_mode %}
        {% if leaderboard.generated_at %} · {% endif %}
        <a href="{{ sheetConfig.picks_tab_url }}" target="_blank" rel="noopener noreferrer"
           class="hover:text-gray-700 dark:hover:text-gray-400 transition">📊 Dữ liệu gốc ↗</a>
      {% endif %}
    </p>
  </div>

  {% set _upcoming = [] %}{% set _finished = [] %}
  {% for f in fixtures.data %}
    {% if f.status == "upcoming" %}{% set _upcoming = _upcoming.concat([1]) %}{% endif %}
    {% if f.is_finished %}{% set _finished = _finished.concat([1]) %}{% endif %}
  {% endfor %}
  <div class="text-xs text-gray-500 dark:text-gray-600 flex gap-4">
    {% if _upcoming | length %}<span>📈 Sắp diễn ra: <strong class="text-gray-700 dark:text-gray-400">{{ _upcoming | length }}</strong></span>{% endif %}
    {% if _finished | length %}<span>✅ Đã kết thúc: <strong class="text-gray-700 dark:text-gray-400">{{ _finished | length }}</strong></span>{% endif %}
  </div>

  <div class="bg-white dark:bg-gray-900 rounded-xl overflow-x-auto" x-show="rows.length">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-gray-500 text-xs border-b border-gray-200 dark:border-gray-800">
          <th class="text-left px-2 py-2.5 sm:px-4 sm:py-3 w-8 sm:w-auto">#</th>
          <th class="text-left px-2 py-2.5 sm:px-4 sm:py-3">Người chơi</th>
          <th class="text-right px-2 py-2.5 sm:px-4 sm:py-3 hidden sm:table-cell">Đã gửi</th>
          {% if siteConfig.points.NO_PICK < 0 %}
          <th class="text-right px-2 py-2.5 sm:px-4 sm:py-3 hidden sm:table-cell">Bỏ qua</th>
          {% endif %}
          <th class="text-right px-2 py-2.5 sm:px-4 sm:py-3">
            {% if siteConfig.points.PUSH != siteConfig.points.LOSE %}
              <span class="hidden sm:inline">Đúng / Hòa chấp / Sai</span>
              <span class="sm:hidden">Đ / H / S</span>
            {% else %}
              <span class="hidden sm:inline">Đúng / Sai</span>
              <span class="sm:hidden">Đ / S</span>
            {% endif %}
          </th>
          <th class="text-right px-2 py-2.5 sm:px-4 sm:py-3">Điểm</th>
          <th class="text-right px-2 py-2.5 sm:px-4 sm:py-3 w-20" x-show="currentUser" x-cloak></th>
        </tr>
      </thead>
      <tbody>
        <template x-for="(user, idx) in rows" :key="user.user_id">
          <tr class="border-b border-gray-100 dark:border-gray-800 last:border-0 hover:bg-gray-50 dark:hover:bg-gray-800 transition"
              :class="idx < 3 ? 'font-semibold' : ''">
            <td class="px-2 py-2.5 sm:px-4 sm:py-3 text-gray-500 text-base">
              <span :class="idx >= 3 ? 'text-gray-400 dark:text-gray-600' : ''"
                    x-text="idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : (idx + 1)"></span>
            </td>
            <td class="px-2 py-2.5 sm:px-4 sm:py-3 text-gray-900 dark:text-white max-w-[8rem] sm:max-w-none truncate">
              <span x-text="user.display_name"></span>
              <span x-show="user._new"
                    class="ml-1 text-[10px] font-normal text-blue-400 dark:text-blue-500 align-middle">mới</span>
            </td>
            <td class="px-2 py-2.5 sm:px-4 sm:py-3 text-right text-gray-500 hidden sm:table-cell"
                x-text="user.total_submitted != null ? user.total_submitted : user.played"></td>
            {% if siteConfig.points.NO_PICK < 0 %}
            <td class="px-2 py-2.5 sm:px-4 sm:py-3 text-right text-pink-400 dark:text-pink-500 hidden sm:table-cell"
                x-text="user.no_picks ?? 0"></td>
            {% endif %}
            <td class="px-2 py-2.5 sm:px-4 sm:py-3 text-right text-gray-500 text-xs whitespace-nowrap">
              <span class="text-emerald-500 dark:text-emerald-400" x-text="user.wins"></span>
              {% if siteConfig.points.PUSH != siteConfig.points.LOSE %}
              /
              <span class="text-yellow-500 dark:text-yellow-400" x-text="user.draws"></span>
              {% endif %}
              /
              <span class="text-red-500 dark:text-red-400"
                    x-text="{{ 'user.losses + user.draws' if siteConfig.points.PUSH == siteConfig.points.LOSE else 'user.losses' }}"></span>
            </td>
            <td class="px-2 py-2.5 sm:px-4 sm:py-3 text-right font-bold text-lg"
                :class="user.points > 0 ? 'text-emerald-500 dark:text-emerald-400' : user.points < 0 ? 'text-red-500 dark:text-red-400' : 'text-gray-400'"
                x-text="(user.points > 0 ? '+' : '') + user.points"></td>
            <td class="px-2 py-2.5 sm:px-4 sm:py-3 text-right whitespace-nowrap" x-show="currentUser" x-cloak>
              <button @click="openCopyModal(user)"
                      x-show="user.user_id !== currentUser.user_id"
                      class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded-lg bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-100 dark:hover:bg-indigo-900/30 transition cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H5.25m11.9-3.675A2.062 2.062 0 1 1 20.1 7.2l-9 9m9-9H17.25V5.25" />
                </svg>
                <span class="hidden sm:inline">Sao chép</span>
              </button>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>

  <div class="bg-white dark:bg-gray-900 rounded-xl p-4 text-xs text-gray-500 dark:text-gray-600 space-y-1"
       x-show="rows.length">
    <p><span class="font-semibold text-gray-600 dark:text-gray-400">Cách tính điểm:</span></p>
    <p>✅ Đoán đúng →
      <span class="text-emerald-500 dark:text-emerald-400 font-semibold">{% if siteConfig.points.WIN > 0 %}+{% endif %}{{ siteConfig.points.WIN }} điểm</span>
    </p>
    {% if siteConfig.points.PUSH != siteConfig.points.LOSE %}
    <p>🤝 Chọn hòa chấp đúng ranh giới (nút "Hòa") →
      <span class="text-yellow-500 dark:text-yellow-400 font-semibold">{% if siteConfig.points.PUSH > 0 %}+{% endif %}{{ siteConfig.points.PUSH }} điểm</span>
    </p>
    {% endif %}
    <p>❌ Đoán sai →
      <span class="{% if siteConfig.points.LOSE < 0 %}text-red-500 dark:text-red-400{% else %}text-gray-500{% endif %} font-semibold">{% if siteConfig.points.LOSE > 0 %}+{% endif %}{{ siteConfig.points.LOSE }} điểm</span>
    </p>
    {% if siteConfig.points.NO_PICK < 0 %}
    <p>📭 Không dự đoán →
      <span class="text-pink-500 dark:text-pink-400 font-semibold">{% if siteConfig.points.NO_PICK > 0 %}+{% endif %}{{ siteConfig.points.NO_PICK }} điểm</span>
    </p>
    {% endif %}
  </div>

  <div class="bg-white dark:bg-gray-900 rounded-xl p-12 text-center text-gray-500"
       x-show="!rows.length">
    <p class="text-4xl mb-3">🏆</p>
    <p>Chưa có dữ liệu xếp hạng.</p>
  </div>

  <!-- Copy confirmation modal -->
  <div x-show="showCopyModal" x-cloak
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-150"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"
       class="fixed inset-0 bg-black/45 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    
    <div @click.outside="if (!copyLoading) showCopyModal = false"
         x-show="showCopyModal"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
         x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
         x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
         class="bg-white dark:bg-gray-900 rounded-2xl shadow-2xl max-w-sm w-full border border-gray-100 dark:border-gray-700 p-6 space-y-4 relative overflow-hidden">
      
      <!-- Header -->
      <div class="flex items-center gap-3 border-b border-gray-100 dark:border-gray-800 pb-3">
        <span class="text-2xl">📋</span>
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Sao chép dự đoán</h3>
      </div>

      <!-- Description -->
      <div class="text-sm text-gray-600 dark:text-gray-400 space-y-2">
        <p>
          Bạn có chắc chắn muốn sao chép toàn bộ dự đoán các trận đấu chưa khóa từ tài khoản
          <strong class="text-gray-900 dark:text-white font-semibold" x-text="copyTarget?.display_name"></strong>?
        </p>
        <p class="text-xs text-amber-600 dark:text-amber-500 font-medium bg-amber-50 dark:bg-amber-950/20 border border-amber-100 dark:border-amber-900/30 p-2.5 rounded-lg leading-normal">
          ⚠️ Dự đoán của bạn ở các trận đấu sắp diễn ra này sẽ bị ghi đè hoàn toàn.
        </p>
      </div>

      <!-- Error / Success Alert -->
      <p x-show="copyMessage" x-cloak
         :class="isCopyError ? 'text-red-500 dark:text-red-400 bg-red-50 dark:bg-red-950/20 border border-red-100 dark:border-red-900/40' : 'text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/20 border border-indigo-100 dark:border-indigo-900/40'"
         class="text-xs p-3 rounded-xl font-medium leading-relaxed" x-text="copyMessage"></p>

      <!-- Footer Action Buttons -->
      <div class="flex gap-2 justify-end pt-2">
        <button @click="showCopyModal = false" :disabled="copyLoading"
                class="px-4 py-2 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">
          Hủy
        </button>
        <button @click="confirmCopy()" :disabled="copyLoading"
                class="bg-indigo-600 hover:bg-indigo-500 disabled:bg-gray-200 dark:disabled:bg-gray-700 disabled:text-gray-400 dark:disabled:text-gray-500 text-white font-semibold px-5 py-2 rounded-xl transition text-sm flex items-center justify-center gap-1.5 cursor-pointer min-w-[5rem]">
          <svg x-show="copyLoading" class="animate-spin -ml-1 mr-1 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
          </svg>
          <span x-text="copyLoading ? 'Đang sao chép...' : 'Xác nhận'"></span>
        </button>
      </div>

    </div>
  </div>
</div>
