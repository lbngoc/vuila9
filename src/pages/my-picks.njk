---
layout: base.njk
title: Dự đoán của tôi
permalink: /my-picks/
---

<script>
  const MY_PICKS_DATA    = {{ picks.data | dump | safe }};
  const MY_FIXTURE_DATA  = {{ fixtures.data | dump | safe }};
</script>

<div x-data="myPicksPage(MY_PICKS_DATA, MY_FIXTURE_DATA)" x-init="init()">

  <!-- Not logged in -->
  <div x-show="!user" x-cloak class="text-center py-16 space-y-4">
    <p class="text-4xl">🔒</p>
    <p class="text-gray-500 dark:text-gray-400">Bạn cần đăng nhập để xem lịch sử dự đoán.</p>
    <a href="/login/" class="inline-block bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-6 py-2.5 rounded-lg transition">
      Đăng nhập
    </a>
  </div>

  <!-- Logged in -->
  <div x-show="user" x-cloak class="space-y-6">

    <!-- Header -->
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
          Dự đoán của <span x-text="user?.display_name"></span>
        </h1>
        <p class="text-sm text-gray-500 mt-1">
          <span x-text="resolvedCount"></span>/<span x-text="picks.length"></span> đã kết thúc
          &nbsp;·&nbsp;
          Tổng điểm:
          <span class="font-bold"
                :class="totalPoints > 0 ? 'text-emerald-500 dark:text-emerald-400' : totalPoints < 0 ? 'text-red-500 dark:text-red-400' : 'text-gray-400'"
                x-text="ptDisplay(totalPoints)">
          </span>
        </p>
      </div>
      <button @click="doLogout()"
              class="text-xs text-gray-500 dark:text-gray-600 hover:text-gray-700 dark:hover:text-gray-300 transition mt-1 flex-shrink-0 flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15" />
        </svg>
        Đăng xuất
      </button>
    </div>

    <!-- Empty state -->
    <template x-if="picks.length === 0">
      <div class="bg-white dark:bg-gray-900 rounded-xl p-12 text-center text-gray-500">
        <p class="text-3xl mb-3">🎯</p>
        <p>Bạn chưa có dự đoán nào.</p>
        <a href="/fixtures/" class="inline-block mt-4 text-emerald-600 dark:text-emerald-400 hover:text-emerald-500 dark:hover:text-emerald-300 text-sm">Xem lịch thi đấu →</a>
      </div>
    </template>

    <!-- Picks list -->
    <div x-data="{ showAll: false }" class="space-y-3">
      <div class="space-y-3">
        <template x-for="pick in (showAll ? picks : picks.slice(0, 10))" :key="pick.pick_id">
          <div class="bg-white dark:bg-gray-900 rounded-xl p-4">

            <!-- Row 1: match + result badge -->
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 min-w-0">
                <p class="text-gray-900 dark:text-white font-medium text-sm leading-snug"
                   x-text="(fixtures[pick.fixture_id]?.home_team ?? '?') + ' vs ' + (fixtures[pick.fixture_id]?.away_team ?? '?')">
                </p>
                <p class="text-gray-500 text-xs mt-0.5" x-text="formatDate(pick.created_at)"></p>
              </div>

              <!-- Result badge -->
              <span x-show="pick.result"
                    :class="resultClass(pick.result)"
                    class="text-xs font-semibold px-2 py-0.5 rounded flex-shrink-0"
                    x-text="resultLabel(pick.result)">
              </span>
              <template x-if="!pick.result">
                <span class="flex-shrink-0">
                  <span x-show="pick._pending" x-cloak class="text-xs text-yellow-600 dark:text-yellow-500/80">(chưa sync)</span>
                  <span x-show="!pick._pending" class="text-xs text-gray-400 dark:text-gray-700">Chưa KT</span>
                </span>
              </template>
            </div>

            <!-- Row 2: pick + score + points -->
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-3 text-sm">
              <span class="text-gray-600 dark:text-gray-400" x-text="pickLabel(pick)"></span>

              <template x-if="fixtures[pick.fixture_id]?.handicap">
                <span class="text-gray-500 text-xs">
                  (điểm chấp
                  <span x-text="Math.abs(parseFloat(fixtures[pick.fixture_id].handicap))"></span>
                  bàn)
                </span>
              </template>

              <template x-if="fixtures[pick.fixture_id]?.is_finished">
                <span class="text-gray-500 text-xs">
                  KQ:
                  <span class="text-gray-900 dark:text-white"
                        x-text="fixtures[pick.fixture_id].result_home + '–' + fixtures[pick.fixture_id].result_away">
                  </span>
                </span>
              </template>

              <span x-show="pick.points != null"
                    class="ml-auto font-bold"
                    :class="pick.points > 0 ? 'text-emerald-500 dark:text-emerald-400' : pick.points < 0 ? 'text-red-500 dark:text-red-400' : 'text-gray-500'"
                    x-text="ptDisplay(pick.points) + ' điểm'">
              </span>
            </div>

          </div>
        </template>
      </div>

      <template x-if="picks.length > 10">
        <div class="flex justify-center pt-1">
          <button @click="showAll = !showAll"
                  class="inline-flex items-center gap-1.5 px-5 py-2 rounded-full text-sm font-medium
                         bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300
                         hover:bg-gray-200 dark:hover:bg-gray-700
                         border border-gray-200 dark:border-gray-700
                         transition-colors duration-150">
            <span x-show="!showAll">
              Xem thêm
              <span class="text-xs text-gray-400 dark:text-gray-500 font-normal" x-text="'(' + (picks.length - 10) + ' trận)'"></span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 inline ml-0.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
              </svg>
            </span>
            <span x-show="showAll" x-cloak>
              Thu gọn
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 inline ml-0.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M14.78 11.78a.75.75 0 0 1-1.06 0L10 8.06l-3.72 3.72a.75.75 0 0 1-1.06-1.06l4.25-4.25a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06Z" clip-rule="evenodd"/>
              </svg>
            </span>
          </button>
        </div>
      </template>
    </div>

    <!-- Scoring legend -->
    <div class="bg-white dark:bg-gray-900 rounded-xl p-4 text-xs text-gray-500 dark:text-gray-600 flex flex-wrap gap-x-5 gap-y-1">
      {% include "scoring-legend.njk" %}
    </div>

  </div>
</div>
