---
layout: base.njk
title: Dự đoán của tôi
permalink: /my-picks/
---

<script>
  const MY_BETS_DATA     = {{ bets.data | dump | safe }};
  const MY_FIXTURE_DATA  = {{ fixtures.data | dump | safe }};
</script>

<div x-data="myBetsPage(MY_BETS_DATA, MY_FIXTURE_DATA)" x-init="init()">

  <!-- Not logged in -->
  <div x-show="!user" x-cloak class="text-center py-16 space-y-4">
    <p class="text-4xl">🔒</p>
    <p class="text-gray-500 dark:text-gray-400">Bạn cần đăng nhập để xem lịch sử dự đoán.</p>
    <a href="/login/" class="inline-block bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-6 py-2.5 rounded-lg transition">
      Đăng nhập
    </a>
  </div>

  <!-- Logged in -->
  <div x-show="user" x-cloak class="space-y-6">

    <!-- Header -->
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
          Dự đoán của <span x-text="user?.display_name"></span>
        </h1>
        <p class="text-sm text-gray-500 mt-1">
          <span x-text="resolvedCount"></span>/<span x-text="bets.length"></span> đã kết thúc
          &nbsp;·&nbsp;
          Tổng điểm:
          <span class="font-bold"
                :class="totalPoints > 0 ? 'text-emerald-500 dark:text-emerald-400' : totalPoints < 0 ? 'text-red-500 dark:text-red-400' : 'text-gray-400'"
                x-text="ptDisplay(totalPoints)">
          </span>
        </p>
      </div>
      <button @click="doLogout()"
              class="text-xs text-gray-500 dark:text-gray-600 hover:text-gray-700 dark:hover:text-gray-300 transition mt-1 flex-shrink-0 flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15" />
        </svg>
        Đăng xuất
      </button>
    </div>

    <!-- Empty state -->
    <template x-if="bets.length === 0">
      <div class="bg-white dark:bg-gray-900 rounded-xl p-12 text-center text-gray-500">
        <p class="text-3xl mb-3">🎯</p>
        <p>Bạn chưa có dự đoán nào.</p>
        <a href="/fixtures/" class="inline-block mt-4 text-emerald-600 dark:text-emerald-400 hover:text-emerald-500 dark:hover:text-emerald-300 text-sm">Xem lịch thi đấu →</a>
      </div>
    </template>

    <!-- Bets list -->
    <div class="space-y-3">
      <template x-for="bet in bets" :key="bet.bet_id">
        <div class="bg-white dark:bg-gray-900 rounded-xl p-4">

          <!-- Row 1: match + result badge -->
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <p class="text-gray-900 dark:text-white font-medium text-sm leading-snug"
                 x-text="(fixtures[bet.fixture_id]?.home_team ?? '?') + ' vs ' + (fixtures[bet.fixture_id]?.away_team ?? '?')">
              </p>
              <p class="text-gray-500 text-xs mt-0.5" x-text="formatDate(bet.created_at)"></p>
            </div>

            <!-- Result badge -->
            <span x-show="bet.result"
                  :class="resultClass(bet.result)"
                  class="text-xs font-semibold px-2 py-0.5 rounded flex-shrink-0"
                  x-text="resultLabel(bet.result)">
            </span>
            <template x-if="!bet.result">
              <span class="flex-shrink-0">
                <span x-show="bet._pending" x-cloak class="text-xs text-yellow-600 dark:text-yellow-500/80">(chưa sync)</span>
                <span x-show="!bet._pending" class="text-xs text-gray-400 dark:text-gray-700">Chưa KT</span>
              </span>
            </template>
          </div>

          <!-- Row 2: pick + score + points -->
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-3 text-sm">
            <span class="text-gray-600 dark:text-gray-400" x-text="pickLabel(bet)"></span>

            <template x-if="fixtures[bet.fixture_id]?.handicap">
              <span class="text-gray-500 text-xs">
                (điểm chấp
                <span x-text="Math.abs(parseFloat(fixtures[bet.fixture_id].handicap))"></span>
                bàn)
              </span>
            </template>

            <template x-if="fixtures[bet.fixture_id]?.is_finished">
              <span class="text-gray-500 text-xs">
                KQ:
                <span class="text-gray-900 dark:text-white"
                      x-text="fixtures[bet.fixture_id].result_home + '–' + fixtures[bet.fixture_id].result_away">
                </span>
              </span>
            </template>

            <span x-show="bet.points != null"
                  class="ml-auto font-bold"
                  :class="bet.points > 0 ? 'text-emerald-500 dark:text-emerald-400' : bet.points < 0 ? 'text-red-500 dark:text-red-400' : 'text-gray-500'"
                  x-text="ptDisplay(bet.points) + ' điểm'">
            </span>
          </div>

        </div>
      </template>
    </div>

    <!-- Scoring legend -->
    <div class="bg-white dark:bg-gray-900 rounded-xl p-4 text-xs text-gray-500 dark:text-gray-600">
      <span class="font-semibold text-gray-600 dark:text-gray-400">Điểm:</span>
      Thắng {% if siteConfig.points.WIN > 0 %}+{% endif %}{{ siteConfig.points.WIN }}
      {% if siteConfig.points.PUSH != siteConfig.points.LOSE %} · Hòa chấp {% if siteConfig.points.PUSH > 0 %}+{% endif %}{{ siteConfig.points.PUSH }}{% endif %}
       · Thua {% if siteConfig.points.LOSE > 0 %}+{% endif %}{{ siteConfig.points.LOSE }}
    </div>

  </div>
</div>
